{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knoucsgj-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knoucs-db",
      "database_id": "62c137a5-14cb-4110-83b5-5a7245b54ad2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "knoucs-storage"
    }
  ]
}
